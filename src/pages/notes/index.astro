---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import Main from "@/components/Main.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const notes = (await getCollection("notes", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const bodies = await Promise.all(
  notes.map(async note => {
    const { Content } = await render(note);
    return { note, Content };
  })
);
---

<Layout title={`${t.pages.notesTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={t.pages.notesTitle} pageDesc={t.pages.notesDesc}>
    {
      bodies.length > 0 ? (
        <ul class="mt-8 space-y-6">
          {bodies.map(({ note, Content }) => (
            <li class="border-border rounded-lg border p-5">
              <div class="mb-2 flex flex-wrap items-baseline gap-2">
                <a
                  href={getRelativeLocaleUrl(locale, `notes/${note.id}`)}
                  class="text-accent text-lg font-semibold hover:underline"
                >
                  {note.data.title}
                </a>
                <time
                  class="text-muted-foreground text-sm"
                  datetime={note.data.publishDate.toISOString()}
                >
                  {note.data.publishDate.toLocaleString("zh-CN", {
                    timeZone: "Asia/Shanghai",
                  })}
                </time>
                {note.data.link && (
                  <a
                    href={note.data.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-sm underline decoration-dashed"
                  >
                    链接
                  </a>
                )}
              </div>
              <div class="app-prose prose max-w-none">
                <Content />
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-muted-foreground mt-8">暂无碎碎念。</p>
      )
    }
  </Main>
  <Footer />
</Layout>
